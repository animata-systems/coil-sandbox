{
  "name": "coil-sandbox",
  "version": "0.1.0",
  "description": "Sandbox host environment for COIL",
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": {
    "coil-sandbox": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:viewer",
    "build:viewer": "vite build --config src/web/vite.viewer.config.ts",
    "dev": "tsx watch cli/index.ts apps/arena",
    "start": "node dist/cli/index.js apps/arena",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "ai": "^5.0.52",
    "coil": "github:animata-systems/coil",
    "coil-runtime": "github:animata-systems/coil-runtime",
    "express": "^5.1.0",
    "socket.io": "^4.8.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "coil-ide": "github:animata-systems/coil-ide",
    "monaco-editor": ">=0.25.0 <1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
